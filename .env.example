# Smart Market Watchlist — configuration.
#
# Copy to .env and fill in. Nothing here is required to run: every value has a
# development-safe default, and a missing credential is reported as a coverage fact
# rather than crashing the process.
#
# .env and *.ENV are gitignored. Never commit a real key.

# --- mode ----------------------------------------------------------------------
# live  — real providers, scheduled ingestion.
# judge — a seeded, fixed scenario; no provider is contacted and nothing ingests.
# Anything else fails at startup rather than silently serving the wrong data.
SMART_WATCHLIST_MODE=live

# --- persistence ---------------------------------------------------------------
# One SQLite file holds shared intelligence and private user state. In a container this
# MUST point at a mounted volume, or every restart starts from nothing.
WATCHLIST_DB=/data/watchlist.db

# Judge state, always a separate file. Defaults to the live path with a "judge-" prefix,
# so the two cannot collide even if only WATCHLIST_DB is set.
# JUDGE_DB=/data/judge-watchlist.db

# --- ingestion -----------------------------------------------------------------
# The in-process scheduler. One cycle at a time, one process only (see README).
INGEST_SCHEDULER=on
INGEST_ON_STARTUP=on
INGEST_INTERVAL_MINUTES=15

# --- model-backed extraction ---------------------------------------------------
# Optional. Without it the deterministic rule extractor runs and the system keeps
# working with a plainly weaker reading — never a blank page.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# --- serving -------------------------------------------------------------------
# Point at the built Astro output to serve the frontend from this process, which makes
# the deployment one origin and removes the cross-origin cookie problem entirely.
WEB_DIST=/app/web

# Only needed when the frontend is deployed separately from the API.
# WEB_ORIGINS=https://your-frontend.example

# --- access --------------------------------------------------------------------
# Demo mode resolves anonymous callers to one shared server-owned account, so a judge
# reaches the product without signing up. Every anonymous visitor shares that account's
# watchlist and checkpoint — set to off for any deployment with real users.
DEMO_MODE=on
